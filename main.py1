from flask import Flask, render_template, request
from date time import datetime

app = Flask(__name__)

@app.route('/')
def home():
    return render_template("index.html", age=None, error=None)

@app.route('/calculate', methods=['POST'])
def calculate():
    try:
        birth_year = int(request.form['birth_year'])
        current_year = datetime.now().current_year

        if birth_year > current_year:
            return render_template("index.html", age=None, error="Birth year cannot be in the future")